{
  "name": "uuch-storefront-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --watch server.mjs",
    "start": "node --env-file-if-exists=.env.local server.mjs",
    "storefront:check": "node --env-file-if-exists=.env.local check.mjs",
    "test": "node --test test/*.test.mjs"
  }
}
